#!/bin/sh
# `dsh` on the guest's PATH, so the terminal behaves like a desktop install:
# `dsh plugin --profile web add <pkg>`, `dsh --profile headless "job"`, etc.
#
# --expose-internals: cordis-plugin-hmr needs Node internals; the prebuilt
# node-addon-require-builtin shim has no musl build, so use the flag instead
# (dsh-serve does the same).
exec node --expose-internals /usr/local/lib/node_modules/@deepseek-ai/dsh/lib/bin.js "$@"

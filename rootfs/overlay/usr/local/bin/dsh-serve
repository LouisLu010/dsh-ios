#!/bin/sh
# Launch the DeepSeek Harness web UI inside the DSH iOS app's Linux guest.
#
# The iOS app runs this as the supervised foreground process and points its
# WKWebView at http://127.0.0.1:$DSH_PORT once the server answers.
#
#   DSH_PORT       listen port (default 3080)
#   DSH_WORKSPACE  initial working directory offered as the workspace
#   DSH_HOME       harness home (default /root/.dsh)
export HOME=/root
export PATH="/usr/local/bin:$PATH"
export DSH_HOME="${DSH_HOME:-/root/.dsh}"
export DSH_WORKSPACE="${DSH_WORKSPACE:-/root/workspace}"
PORT="${DSH_PORT:-3080}"

mkdir -p "$DSH_WORKSPACE"

# The harness home has the same layout as on desktop: DSH's own configuration
# is in the @dsh-ios/* bundles under /usr/local/lib/node_modules (they ship
# with the image, so an image update updates them), and both cordis.patch.yml
# files plus the profile's package.json belong to the user and to
# `dsh plugin`. dsh-ios-heal-home makes sure every profile lists the DSH
# bundles, and hands back user layers that older images overwrote.
mkdir -p "$DSH_HOME"
if [ ! -f "$DSH_HOME/profiles/web/package.json" ]; then
    # Let dsh scaffold the profile from its own template first.
    node --expose-internals /usr/local/lib/node_modules/@deepseek-ai/dsh/lib/bin.js \
        --profile web --dump-config >/dev/null || echo "dsh-serve: could not initialize the web profile" >&2
fi
dsh-ios-heal-home || echo "dsh-serve: dsh-ios-heal-home failed; DSH bundles may be missing" >&2

cd "$DSH_WORKSPACE"

# --no-open: the app shows the UI; there is no browser to launch in the guest.
# --expose-internals: cordis-plugin-hmr needs Node internals; the prebuilt
# node-addon-require-builtin shim has no musl build, so use the flag instead.
exec node --expose-internals \
    /usr/local/lib/node_modules/@deepseek-ai/dsh/lib/bin.js \
    web --host 127.0.0.1 --port "$PORT" --no-open "$@"
